# PostgreSQL Database Configuration Example
# Copy this file to .env and configure your local PostgreSQL credentials.
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
# Note: If your password contains special characters like '@', percent-encode it (e.g. '@' -> '%40')
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/phishing_detection_db
TEST_DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/phishing_detection_test_db

# Discrete DB parameters
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=phishing_detection_db
TEST_DB_NAME=phishing_detection_test_db
